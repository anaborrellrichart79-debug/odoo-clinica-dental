<?xml version="1.0" encoding="utf-8"?>
<!-- noupdate: si la clínica cambia una duración, actualizar el módulo no la pisa -->
<odoo noupdate="1">

    <record id="duracion_limpieza" model="clinica.duracion.tratamiento">
        <field name="tratamiento">limpieza</field>
        <field name="minutos">30</field>
    </record>

    <record id="duracion_ortodoncia" model="clinica.duracion.tratamiento">
        <field name="tratamiento">ortodoncia</field>
        <field name="minutos">30</field>
    </record>

    <record id="duracion_protesis" model="clinica.duracion.tratamiento">
        <field name="tratamiento">protesis</field>
        <field name="minutos">60</field>
    </record>

</odoo>
