<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista de lista -->
    <record id="clinica_cita_view_list" model="ir.ui.view">
        <field name="name">clinica.cita.list</field>
        <field name="model">clinica.cita</field>
        <field name="arch" type="xml">
            <list>
                <field name="fecha"/>
                <field name="paciente_id"/>
                <field name="fecha_fin"/>
                <field name="tratamiento_id"/>
                <field name="importe" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="estado" widget="badge"
                       decoration-info="estado == 'confirmada'"
                       decoration-success="estado == 'realizada'"
                       decoration-muted="estado == 'cancelada'"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario (los botones de estado llegan en la fase D) -->
    <record id="clinica_cita_view_form" model="ir.ui.view">
        <field name="name">clinica.cita.form</field>
        <field name="model">clinica.cita</field>
        <field name="arch" type="xml">
            <form>
                <!-- Cabecera: botones de estado y barra de estados -->
                <header>
                    <button name="action_confirmar"
                            type="object"
                            string="Confirmar"
                            class="btn-primary"
                            invisible="estado != 'borrador'"/>

                    <button name="action_realizar"
                            type="object"
                            string="Marcar como realizada"
                            class="btn-primary"
                            invisible="estado != 'confirmada'"/>

                    <button name="action_cancelar"
                            type="object"
                            string="Cancelar"
                            confirm="¿Seguro que quieres cancelar la cita?"
                            invisible="estado not in ('borrador', 'confirmada')"/>

                    <button name="action_borrador"
                            type="object"
                            string="Volver a borrador"
                            invisible="estado != 'cancelada'"/>

                    <!-- La barra de estados va siempre la última del header -->
                    <field name="estado" widget="statusbar"
                           statusbar_visible="borrador,confirmada,realizada"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="paciente_id"/>
                            <field name="tratamiento_id"/>
                            <field name="duracion"/>
                            <field name="dia"/>
                            <!-- Desplegable que solo muestra las horas libres de ese día -->
                            <field name="horas_libres_ids" invisible="1"/>
                            <field name="hora_id" widget="selection"
                                   domain="[('id', 'in', horas_libres_ids)]"/>
                            <field name="fecha_fin"/>
                        </group>
                        <group>
                            <field name="importe"/>
                            <field name="currency_id" invisible="True"/>
                        </group>
                    </group>
                    <field name="notas" placeholder="Notas de la cita..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vista de búsqueda: filtros y agrupaciones -->
    <record id="clinica_cita_view_search" model="ir.ui.view">
        <field name="name">clinica.cita.search</field>
        <field name="model">clinica.cita</field>
        <field name="arch" type="xml">
            <search>
                <field name="paciente_id"/>
                <field name="tratamiento_id"/>
                <filter string="Borrador" name="filtro_borrador"
                        domain="[('estado', '=', 'borrador')]"/>
                <filter string="Confirmada" name="filtro_confirmada"
                        domain="[('estado', '=', 'confirmada')]"/>
                <filter string="Realizada" name="filtro_realizada"
                        domain="[('estado', '=', 'realizada')]"/>
                <filter string="Cancelada" name="filtro_cancelada"
                        domain="[('estado', '=', 'cancelada')]"/>
                <separator/>
                <filter string="Fecha" name="filtro_fecha" date="fecha"/>
                <group>
                    <filter string="Paciente" name="agrupar_paciente"
                            context="{'group_by': 'paciente_id'}"/>
                    <filter string="Estado" name="agrupar_estado"
                            context="{'group_by': 'estado'}"/>
                    <filter string="Tratamiento" name="agrupar_tratamiento"
                            context="{'group_by': 'tratamiento_id'}"/>
                    <filter string="Mes" name="agrupar_mes"
                            context="{'group_by': 'fecha:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción: abre las citas (la usa el menú) -->
    <record id="clinica_cita_action" model="ir.actions.act_window">
        <field name="name">Citas</field>
        <field name="res_model">clinica.cita</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea la primera cita
            </p>
        </field>
    </record>

</odoo>
